<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ridgeway Cargo | Cozy Driving Game for Android</title>
<meta name="description" content="Ridgeway Cargo is a calm cargo-driving game for Android by Keramoti Studio. Download it on Google Play.">
<meta property="og:title" content="Ridgeway Cargo | Cozy Driving Game for Android">
<meta property="og:description" content="Haul cargo along quiet roads at your own pace. Available on Google Play.">
<meta property="og:type" content="website">
<style>
  :root{
    --bg:#f7f4ec; --card:#ffffff; --ink:#1f2a24; --muted:#5b6b62;
    --green:#2f5d46; --green-dark:#234a37; --orange:#e8782a; --line:#e3ddcf;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6;-webkit-text-size-adjust:100%}
  a{color:var(--green)}
  .wrap{max-width:960px;margin:0 auto;padding:0 20px}

  header{padding:16px 0}
  .brand{display:flex;align-items:center;gap:10px;font-weight:700;letter-spacing:.04em;font-size:14px;text-transform:uppercase;color:var(--ink);text-decoration:none}
  .logo{width:34px;height:34px;border-radius:8px;background:var(--orange);color:#fff;display:grid;place-items:center;font-weight:800;font-size:14px;letter-spacing:0}

  .hero{padding:24px 0 8px;text-align:center}
  .hero h1{font-size:clamp(2rem,7vw,3.2rem);line-height:1.1;margin-bottom:12px}
  .hero p.lead{font-size:clamp(1.05rem,3.4vw,1.25rem);color:var(--muted);max-width:560px;margin:0 auto 24px}
  .cta{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--green);color:#fff;text-decoration:none;font-weight:700;font-size:1.1rem;padding:16px 28px;border-radius:14px;min-height:56px;box-shadow:0 6px 18px rgba(47,93,70,.25);transition:background .15s,transform .15s}
  .cta:hover{background:var(--green-dark)}
  .cta:active{transform:scale(.98)}
  .cta svg{width:22px;height:22px;fill:currentColor}
  .fine{font-size:.85rem;color:var(--muted);margin-top:12px}

  .scene{margin:28px auto 0;max-width:720px;border-radius:20px;overflow:hidden;border:1px solid var(--line);background:#cfe3d3}
  .scene svg{display:block;width:100%;height:auto}

  section{padding:44px 0 0}
  h2{font-size:1.5rem;margin-bottom:18px;text-align:center}
  .grid{display:grid;gap:14px;grid-template-columns:1fr}
  @media(min-width:700px){.grid{grid-template-columns:repeat(3,1fr)}}
  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px}
  .card h3{font-size:1.05rem;margin-bottom:6px}
  .card p{color:var(--muted);font-size:.97rem}
  .icon{width:40px;height:40px;border-radius:10px;background:#eaf2ec;display:grid;place-items:center;margin-bottom:12px;font-size:20px}

  ol.steps{list-style:none;counter-reset:s;display:grid;gap:12px;max-width:560px;margin:0 auto}
  ol.steps li{counter-increment:s;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px 16px 14px 56px;position:relative}
  ol.steps li::before{content:counter(s);position:absolute;left:14px;top:50%;transform:translateY(-50%);width:30px;height:30px;border-radius:50%;background:var(--orange);color:#fff;font-weight:700;display:grid;place-items:center}

  .trust{background:#eaf2ec;border:1px solid #d3e3d8;border-radius:16px;padding:22px;max-width:640px;margin:0 auto;text-align:center}
  .trust h2{font-size:1.2rem;margin-bottom:8px}
  .trust p{color:var(--muted);font-size:.97rem}

  .final{text-align:center;padding:44px 0 8px}
  .final h2{margin-bottom:14px}

  footer{margin-top:44px;padding:26px 0 36px;border-top:1px solid var(--line);text-align:center;color:var(--muted);font-size:.88rem}
  footer a{margin:0 8px}
  footer p+p{margin-top:6px}

  .sticky{display:none}
  @media(max-width:699px){
    .sticky{display:block;position:fixed;left:0;right:0;bottom:0;padding:10px 16px calc(10px + env(safe-area-inset-bottom));background:rgba(247,244,236,.96);border-top:1px solid var(--line);backdrop-filter:blur(6px)}
    .sticky .cta{width:100%}
    body{padding-bottom:84px}
  }
  :focus-visible{outline:3px solid var(--orange);outline-offset:3px}
</style>
</head>
<body>

