<script>
/* Passes the ad's UTM tags through to Google Play so installs can be traced
   in Play Console (Statistics > Acquisition > UTM-tracked traffic).
   If the page is opened without UTMs, it uses the defaults below. */
(function () {
  try {
    var p = new URLSearchParams(window.location.search);
    var utm = new URLSearchParams();
    utm.set("utm_source", p.get("utm_source") || "meta");
    utm.set("utm_medium", p.get("utm_medium") || "paid_social");
    utm.set("utm_campaign", p.get("utm_campaign") || "ridgeway_traffic");
    var c = p.get("utm_content"); if (c) utm.set("utm_content", c);
    var referrer = encodeURIComponent(utm.toString());
    document.querySelectorAll("a.play-link").forEach(function (a) {
      a.href = a.href + "&referrer=" + referrer;
    });
  } catch (e) { /* links still work without tracking */ }
})();
</script>
